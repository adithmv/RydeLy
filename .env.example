# Flask Environment
FLASK_ENV=development
SECRET_KEY=your-random-secret-32-chars-min

# Firebase Admin SDK (Backend)
# Option 1: Service account file (development) — RECOMMENDED
# Download from Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=

# Option 2: Individual variables (production / Railway)
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_PRIVATE_KEY_ID=
# FIREBASE_CLIENT_CERT_URL=

# Firebase Realtime Database
# Get from Firebase Console > Realtime Database
FIREBASE_DATABASE_URL=

# OpenRouteService (for routing & geocoding)
# Get from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173