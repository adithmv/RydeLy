FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app
FIREBASE_CREDENTIALS_PATH=C:/private/rydely-service-account.json
ORS_API_KEY=replace-with-your-server-side-openrouteservice-key
RATELIMIT_STORAGE_URI=memory://
FARE_BASE=35
FARE_INCLUDED_KM=1.5
FARE_PER_KM=18
FARE_COMFORT_MULTIPLIER=1.25
MAX_TRIP_KM=150
DRIVER_RADIUS_KM=8
